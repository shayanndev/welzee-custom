# Composer dependencies (not used at runtime - PHPMailer/ is bundled)
/vendor/

# User uploads (keep directory structure)
/uploads/designs/*
!/uploads/designs/.gitkeep
/uploads/logos/*
!/uploads/logos/.gitkeep

# Secrets / local configuration - NEVER commit
/config/config.local.php
/config/config.php
.env
*.pem
welzee_private/

# Build output, logs, OS files, nonpublic drafts
/deployment_output/
/content_drafts/
*.log
.DS_Store
Thumbs.db
