# assets/models/.htaccess
# Optimization & long-term immutable caching for 3D binary & glTF models

<IfModule mod_mime.c>
    AddType model/gltf-binary .glb
    AddType model/gltf+json   .gltf
    AddType application/json  .json
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE model/gltf+json application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType model/gltf-binary "access plus 1 year"
    ExpiresByType model/gltf+json   "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(glb|gltf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
