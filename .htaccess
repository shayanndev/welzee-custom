Options -MultiViews
RewriteEngine On

# Route for sitemap.xml to sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Prevent processing if file or directory already physically exists
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Redirect external .php requests to extensionless url (optional, for SEO)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Route for Dynamic Blog Post viewing
RewriteRule ^blog/([^/]+)/?$ post.php?slug=$1 [L,QSA]

# Resolve extensionless URLs to .php files internally
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]
